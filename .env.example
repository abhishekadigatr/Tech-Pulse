# ─── Tech Pulse configuration ────────────────────────────────────────────────
# Copy to .env.local. Everything is optional: with no values the app boots with
# an isolated local SQLite database, a generated dev master key and demo data.
# Never commit real values. In production generate each secret with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"

# Public origin of the deployment (used for cookie/redirect/CSRF checks).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bind address / port for the custom HTTP + WebSocket server.
HOST=0.0.0.0
PORT=3000

# 32-byte hex key for the SERVER-side envelope encryption layer (AES-256-GCM).
# Per-user data keys are derived from this with HKDF-SHA256. Required in prod.
DATA_ENCRYPTION_KEY=

# 32-byte hex key used to sign short-lived WebSocket tickets / email tokens.
AUTH_SIGNING_KEY=

# Optional HTTPS JSON feed of hackathon rows (array or { opportunities: [...] }).
# Only rows with approval_status="approved" are ingested; dedupe is by official_url.
OPPORTUNITIES_SHEET_FEED_URL=

# Optional external providers. Both are optional and degrade to curated local data.
OSRM_BASE_URL=
OVERPASS_BASE_URL=

# Set to "production" by `npm start`. Enforces Secure cookies + strict CSP.
NODE_ENV=development
